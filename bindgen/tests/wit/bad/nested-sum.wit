package local:bad;

// A sum inside a sum. One lift applied to the result of another is the next
// step rather than a different one (TODO.md#option-result), so this is refused
// as unbuilt -- and refused by depth, not by shape: the same `option<u64>` one
// level up is good/option.wit.
world w {
  use certirocq:abi/errors@0.1.0.{error};
  export dig: func(x: option<option<u64>>) -> result<u64, error>;
}
